{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "fastapi", "dev", "app/main.py", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "frontend-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "BACKEND_URL=http://localhost:8001 npm --prefix frontend run dev -- --port 3001"],
      "port": 3001
    }
  ]
}
