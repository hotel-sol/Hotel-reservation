# 이 파일을 backend/.env 로 복사해서 값을 채운다. .env는 커밋하지 않는다(저장소 공개).
# 개발은 각자 PC의 MariaDB(로컬)로 한다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel

# 로그인 쿠키 서명 키. 긴 무작위 문자열: python -c "import secrets; print(secrets.token_hex(32))"
# 비우면 서버를 켤 때마다 바뀌어서 재시작하면 모두 로그아웃된다.
SESSION_SECRET=

# python -m db.init_db 가 팀 공용 개발용 관리자 admin01을 만들 때 쓰는 비밀번호(팀에 따로 전달)
ADMIN_PASSWORD=
