# 복사해서 .env 로 쓰세요. .env 는 git 에 올리지 않습니다(저장소 공개).
APP_ENV=local
# 개발은 각자 PC의 MariaDB. 시연 DB가 정해지면 아래 값만 바꿉니다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel
DB_USER=root
DB_PASSWORD=

# 세션 쿠키 서명 키 (python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=change-me
# init_db 가 팀 공용 개발용 관리자 admin01 을 만들 때 쓰는 비밀번호 (팀 채팅으로 받음)
ADMIN_PASSWORD=
# 프론트 주소 (CORS 허용)
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
