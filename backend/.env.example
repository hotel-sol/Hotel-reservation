# 복사해서 .env 로 쓰세요. .env 는 git 에 올리지 않습니다(저장소 공개).
APP_ENV=local

# 팀 Supabase 프로젝트 Hotel-sol(조직 hotel-sol, 도쿄) → Connect → Session pooler 의 URI. 아래가 실제 주소입니다.
# [YOUR-PASSWORD] 를 대괄호까지 지우고 팀 DB 비밀번호로 바꿉니다. 특수문자는 URL 인코딩(@ → %40, # → %23).
# 비밀번호는 팀 채팅으로만 받고 저장소 · 노션에 쓰지 않습니다. Direct connection 은 IPv6 전용이라 Session pooler 를 씁니다.
DATABASE_URL=postgresql://postgres.hlmxpbqemlynxjpyxvyh:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# 내 개발용 스키마: hotel_<영문 이름> (예: hotel_minhyuk). 테스트는 자동으로 hotel_<이름>_test.
# 공용 hotel 은 시연 · 통합 확인용이라 개발 중에는 쓰지 않습니다(시연 서버만 DB_SCHEMA=hotel).
DB_SCHEMA=hotel_myname
# 내 스키마를 init_db · 테스트가 지우고 다시 만들어도 된다는 표시. 시연 서버 .env 에는 넣지 않습니다.
DB_RESET_ALLOWED=true

# 세션 쿠키 서명 키 (python -c "import secrets; print(secrets.token_hex(32))")
# 예시 값. 시연 · 배포(APP_ENV 가 local 아님)는 32자 이상 무작위 값이 아니면 서버가 안 켜짐 (#70)
SESSION_SECRET=change-me
# init_db 가 팀 공용 개발용 관리자 admin01 을 만들 때 쓰는 비밀번호 (팀 채팅으로 받음)
ADMIN_PASSWORD=
# 프론트 주소 (CORS 허용)
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# 객실 사진 공용 저장소(Supabase Storage, 2-A2). 둘 다 비워 두면 위 UPLOAD_DIR(내 컴퓨터)에 저장합니다.
# 키: 대시보드 → Project Settings → API Keys → Secret keys. 서버 전용 비밀 키라 저장소 · 노션 · 채팅에 올리지 않습니다.
# 사진은 버킷 안 <내 DB_SCHEMA>/rooms/ 폴더에 들어가서 각자 연습 사진이 섞이지 않습니다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=room-photos
