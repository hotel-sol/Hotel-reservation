# 복사해서 .env 로 쓰세요. .env 는 git 에 올리지 않습니다.
APP_ENV=local
DB_HOST=your-mssql-host
DB_PORT=1433
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# 세션 쿠키 서명 키 (python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=change-me
# 프론트 주소 (CORS 허용)
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
